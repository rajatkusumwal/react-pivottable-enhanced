{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "react-pivottable-enhanced": ["../standalone/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  // Angular libraries must be published in partial compilation mode: ngc emits
  // ɵɵngDeclareComponent metadata that the consuming app's Angular linker
  // expands. Plain tsc output makes apps fail with TS-992012 ("Component
  // imports must be standalone components").
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictTemplates": true,
    "enableI18nLegacyMessageIdFormat": false
  }
}
