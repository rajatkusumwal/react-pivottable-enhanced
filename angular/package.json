{
  "name": "react-pivottable-enhanced-angular",
  "version": "1.0.1",
  "private": false,
  "license": "MIT",
  "description": "Angular wrapper for react-pivottable-enhanced: a production-grade pivot table with drag & drop fields, filters, charts, drill-through and export.",
  "repository": {
    "type": "git",
    "url": "https://github.com/rajatkusumwal/react-pivottable-enhanced"
  },
  "homepage": "https://github.com/rajatkusumwal/react-pivottable-enhanced#readme",
  "bugs": "https://github.com/rajatkusumwal/react-pivottable-enhanced/issues",
  "keywords": [
    "angular",
    "pivot-table",
    "pivot",
    "grid",
    "analytics",
    "olap"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm --prefix ../standalone run build && node scripts/run-ngc.mjs -p tsconfig.build.json",
    "typecheck": "node scripts/run-ngc.mjs -p tsconfig.build.json --noEmit"
  },
  "devDependencies": {
    "@angular/compiler-cli": "~20.3.28"
  },
  "peerDependencies": {
    "@angular/common": ">=16 <22",
    "@angular/core": ">=16 <22",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-pivottable-enhanced": "^1.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
