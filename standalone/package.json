{
  "name": "inhouse-grid-monster",
  "version": "1.0.0",
  "private": false,
  "description": "Flexmonster-like pivot table for React. Copy src/pivot into your app, or build this folder as a library.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/pivot-theme.css"
  },
  "files": ["dist", "src"],
  "scripts": {
    "sync": "node scripts/sync-from-app.mjs",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "lucide-react": "^0.575.0",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0"
  }
}
